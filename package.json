{
  "name": "voxelcraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "node server/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
