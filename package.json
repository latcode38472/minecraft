    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "three": "^0.169.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.8"
  }
}
